# ==============================================================================
# Secure Hospital RAG RBAC - Environment Configuration Template
# ==============================================================================

# Application Environment: 'development' or 'production'
ENVIRONMENT=development

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# Secret Key for HMAC-SHA256 JWT Token Signing
# [CRITICAL SECURITY NOTICE]: In production, set this to a strong 256-bit random string.
# The server will refuse to start in 'production' mode if default key is used.
JWT_SECRET=hospital_rag_secure_hmac_secret_key_2026_capstone_csa47

# Token Expiration Settings
TOKEN_EXPIRY_MINUTES=60
BREAK_GLASS_EXPIRY_MINUTES=15

# LLM Backend Provider: 'mock' (offline deterministic), 'gemini', or 'openai'
LLM_PROVIDER=mock

# Live API Keys (Required only if LLM_PROVIDER is 'gemini' or 'openai')
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Allowed CORS Origins (comma-separated, or '*' for open development)
CORS_ORIGINS=*

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# SQLite Write-Ahead Logging (WAL) Mode for High Concurrency (true/false)
SQLITE_WAL_MODE=true
