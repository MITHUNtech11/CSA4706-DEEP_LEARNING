  "change_summary": "Add Medical Researcher role with de-identified aggregate clinical view and zero personal identifiers.",
  "new_roles": {
    "Clinical Researcher": {
      "level": 2,
      "permissions": {
        "full_medical_record": false,
        "general_clinical_details": true,
        "personal_identifiers": false
      },
      "scope": "DE_IDENTIFIED_COHORT",
      "allowed_actions": ["read_clinical_aggregate"],
      "field_masking": ["full_name", "patient_id", "phone_number", "home_address", "national_id"]
    }
  }
